ss transition for new hires. Begin by identifying hiring needs and creating job descriptions in parallel with sourcing candidates through various channels, such as job boards and referrals. Simultaneously, conduct initial screenings and interviews to assess candidate qualifications and cultural fit. As candidates progress through the recruitment process, prepare onboarding materials and training modules tailored to their roles and responsibilities. Parallel to onboarding preparation, finalize job offers and negotiate terms with selected candidates. Post-offer acceptance, coordinate logistics for new hire orientation and setup, ensuring a smooth onboarding experience from day one."];var fj=ee(8370),bj=ee.n(fj);(0,re.createCustomElement)("sn-ws-asset-example",{behaviors:[],initialState:{},properties:{exampleAiPrompts:{default:[],schema:{type:"array"}},undoButtonDisabled:{default:!1,schema:{type:"boolean"}},redoButtonDisabled:{default:!1,schema:{type:"boolean"}},regenerateButtonDisabled:{default:!1,schema:{type:"boolean"}},isInPreviewMode:{default:!1,schema:{type:"boolean"}},tryExampleButtonDisabled:{default:!1,schema:{type:"boolean"}},type:{default:"",schema:{type:"string"}},hideRegenerateButton:{default:!0,schema:{type:"boolean"}}},renderer:{type:se.default},view:(e,t)=>{let{dispatch:a}=t;const{properties:{exampleAiPrompts:i,undoButtonDisabled:o,redoButtonDisabled:n,isInPreviewMode:r,regenerateButtonDisabled:s,tryExampleButtonDisabled:l,hideRegenerateButton:M=!1,type:c}}=e;return(0,se.createElement)("div",{className:"try-example-container"},(0,se.createElement)("now-button-bare",{"on-click":()=>((e,t)=>{fd.setPrompts(t),e(Js,{name:IM,getExamplePrompt:fd.getInstance()})})(a,i),className:"try-example-prompt",variant:"primary",size:"sm",label:vM,"icon-start":"arrow-right-fill",disabled:l}),(0,se.createElement)("now-popover",{"interaction-type":"none",focusPanel:!0},(0,se.createElement)("now-button-iconic",{slot:"trigger",icon:"circle-info-outline",size:"sm",variant:"ter